function uv {
    if command -v uv &>/dev/null; then
        command uv "$@"
    else
        curl -LsSf https://astral.sh/uv/install.sh | sh
        command uv "$@"
    fi
}

function zact {
    deactivate > /dev/null 2>&1
    z "$1" && source ./.venv/bin/activate && cd -
}

function zreact {
    zact "$1"
}

function pyact {
    deactivate > /dev/null 2>&1
    source $(realpath $1)/.venv/bin/activate
}

function preyact {
    pyact "$@"
}

function fix_vpn_ethernet {
    sudo ip link set dev eth0 mtu 1350
}
function search {
    if [ -n "$1" ] && [ -n "$2" ]; then
        ll "$2" | grep "$1"
    elif [ -n "$1" ]; then
        ll . | grep "$1"
    else
        echo "Usage: $0 <search-expr> [search-path]"
    fi
}

