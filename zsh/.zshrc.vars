# -----------------------------------------------------------------------------
# Directories
# -----------------------------------------------------------------------------

loc=${HOME}/.local
bin=${HOME}/.local/bin
opt=${HOME}/.local/opt
lib=${HOME}/.local/lib
jar=${HOME}/.local/lib/jar
cfg=${XDG_CONFIG_HOME-"$HOME/.config"}
config=${XDG_CONFIG_HOME-"$HOME/.config"}
project="${HOME}/.project"

# -----------------------------------------------------------------------------
# Project
# -----------------------------------------------------------------------------
#
git="${project}/git"
work="${project}/work"
templates="${project}/templates"
playground="${project}/playground"

# -----------------------------------------------------------------------------
# Configurations
# -----------------------------------------------------------------------------

sshrc="${HOME}/.ssh"
vimrc="${HOME}/.vimrc"
zshrc="${HOME}/.zshrc"
ushrc="${HOME}/.zshrc.$USER"

# -----------------------------------------------------------------------------
# XDG Compliant Configurations
# -----------------------------------------------------------------------------

uvrc="${config}/uv/uv.toml"
gitrc="${config}/git/config"
nvimrc="${config}/nvim"
tmuxrc="${config}/tmux/tmux.conf"
kittyrc="${config}/kitty"
aliasrc="${HOME}/.zshrc.aliases"
socxrc="${HOME}/.config/socx/socx.yaml"
socxlog="${HOME}/.local/state/socx/log"


# -----------------------------------------------------------------------------
# Common Git Directories
# -----------------------------------------------------------------------------

# roots
gitusr="${git}/users"
gitlang="${git}/languages"

# users
kety="${git}/users/ketyvagenfeld"
mygit="${git}/users/sagikimhi"

# (my) common
dot="${mygit}/common/dotfiles"

# (my) organizations
orgs="${mygit}/organizations"
myorg="${orgs}/runsonmymachine"
wiliot="${orgs}/wiliot"
speedata="${orgs}/speedata"

# (my) university
uni="${mygit}/university"
unios="${uni}/operating-systems"
unico="${uni}/computer-organization"
unidb="${uni}/database-systems"
unisys="${uni}/systems-programming-lab"
unijava="${uni}/intro-to-cs-and-java"

# -----------------------------------------------------------------------------
# Templates
# -----------------------------------------------------------------------------

c_templates="${project}/templates/c"
git_templates="${project}/templates/git"
java_templates="${project}/templates/java"
python_templates="${project}/templates/python"
vscode_templates="${project}/templates/vscode"

# -----------------------------------------------------------------------------
# Tool/Language Playgrounds
# -----------------------------------------------------------------------------

c_playground="${playground}/c"
java_playground="${playground}/java"
python_playground="${playground}/python"
vscode_playground="${playground}/vscode"
