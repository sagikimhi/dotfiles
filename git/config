                                                # email, ssh sign key, etc.

[core]
    safecrlf = true
    autocrlf = false
    fsmonitor = true
    untrackedCache = true

[log]
    decorate = full

[user]
    useConfigOnly = true

[init]
    defaultBranch = main

[pull]
    rebase = true
    fastForward = only

[push]
    followTags = true
    recurseSubmodules = on-demand

[diff]
    renames = true
    wordRegex = .
    submodule = log
    algorithm = minimal

[fetch]
    all = true
    prune = true
    parallel = 0
    recurseSubmodules = true

[rerere]
    enabled = true
    autoUpdate = true

[rebase]
    stat = true

[status]
    branch = true
    renames = true
    aheadBehind = true
    submoduleSummary = true

[checkout]
    workers = 0
    thresholdForParallelism = 20

[submodule]
    recurse = true
    fetchJobs = 0
    propagateBranches = true

[color]
    ui = always
    grep = always
    diff = always
    branch = true
    status = always
    showBranch = true

[alias]
    la = "!git config -l | grep alias | cut -c 7-"  # List all aliases

    # -------------------------------------------------------------------------
    # git push aliases
    # -------------------------------------------------------------------------

    fpush = push --force-with-lease

    # -------------------------------------------------------------------------
    # git show aliases
    # -------------------------------------------------------------------------

    sshow=show -s --date=short --pretty='format:%C(red)%h %C(reset)(%s, %ad)'

    # -------------------------------------------------------------------------
    # git add aliases
    # -------------------------------------------------------------------------

    a = add
    ap = add -p
    aa = !sh -c 'git diff -U0 -w --no-color --src-prefix=a/ --dst-prefix=b/ "$@" | git apply --cached --ignore-whitespace --unidiff-zero -'

    # -------------------------------------------------------------------------
    # git checkout aliases
    # -------------------------------------------------------------------------

    co = checkout --progress
    cob = checkout --progress -b # <new_branch> [<start_point>]

    # -------------------------------------------------------------------------
    # git commit aliases
    # -------------------------------------------------------------------------

    c = commit -s --verbose
    m = commit --amend --verbose
    ca = commit -s -a --verbose
    cm = commit --verbose -s -m
    cam = commit --verbose -s -a -m

    # -------------------------------------------------------------------------
    # git diff aliases
    # -------------------------------------------------------------------------

    d = diff
    dw = diff --color-moved-ws=allow-indentation-change
    ds = diff --stat
    dc = diff --cached

    # -------------------------------------------------------------------------
    # git stash aliases
    # -------------------------------------------------------------------------

    stasha = stash --all

    # -------------------------------------------------------------------------
    # git status aliases
    # -------------------------------------------------------------------------

    s = status --branch --renames --short --verbose
    sl = status --branch --renames --long --verbose
    slv = status --branch --renames --long --show-stash --verbose
    sli = status --branch --renames --long --show-stash --ignored --verbose

    # -------------------------------------------------------------------------
    # git branch aliases
    # -------------------------------------------------------------------------

    b = branch
	bb = !better-branch.sh
    bl = branch --sort='-authordate' --format='%(color:red)%(objectname:short)%20%(color:yellow)%(authordate:short)%20%(color:cyan)%(HEAD)%20%(color:reset)%(refname:short)%20%(color:green)(%(authordate:relative))'
    ba = branch --all --sort='-authordate' --format='%(color:red)%(objectname:short)%20%(color:yellow)%(authordate:short)%20%(color:cyan)%(HEAD)%20%(color:reset)%(refname:short)%20%(color:green)(%(authordate:relative))'
    br = branch --remotes --sort='-authordate' --format='%(color:red)%(objectname:short)%20%(color:yellow)%(authordate:short)%20%(color:cyan)%(HEAD)%20%(color:reset)%(refname:short)%20%(color:green)(%(authordate:relative))'

    # -------------------------------------------------------------------------
    # git log aliases
    # -------------------------------------------------------------------------

    l = log --abbrev-commit --branches --graph --date=iso --decorate=full\
        --pretty='format: %C(red)%h%C(reset) %C(cyan)%ad%C(reset) %s %C(bold blue)[%an]%C(reset)%C(yellow)%d%C(reset)'

    ll = log --abbrev-commit --branches --graph --date=iso --decorate=full \
        --pretty='format: %C(red)%h%C(reset) %C(cyan)%ad%C(reset) %s %C(bold blue)[%an]%C(reset)%C(yellow)%d%C(reset) %n'

    ls = log --abbrev-commit --branches --graph --date=iso --numstat --decorate=full \
        --pretty='format: %C(red)%h%C(reset) %C(cyan)%ad%C(reset) %s %C(bold blue)[%an]%C(reset)%C(yellow)%d%C(reset)'

    lm = log --abbrev-commit --no-merges --branches --graph --date=iso --decorate=full \
        --pretty='format: %C(red)%h%C(reset) %C(cyan)%ad%C(reset) %s %C(bold blue)[%an]%C(reset)%C(yellow)%d%C(reset)'

    lp = log --abbrev-commit --first-parent --branches --graph --date=iso --decorate=full \
        --pretty='format: %C(red)%h%C(reset) %C(cyan)%ad%C(reset) %s %C(bold blue)[%an]%C(reset)%C(yellow)%d%C(reset)'

    # -------------------------------------------------------------------------
    # branch deletion aliases
    # -------------------------------------------------------------------------

    # Branch Delete.
    #
    # This checks out your local master branch and deletes all
    # local branches that have already been merged to master.
    #
    # brd = "!sh -c \"git checkout main && git branch --merged | grep -v '\\*' | xargs -n 1 git branch -d\""

    # Branch-Delete-Here.
    #
    # Deletes all local branches that have already been merged to the branch
    # that you're currently on.
    #
    # brdhere = "!sh -c \"git branch --merged | grep -v '\\*' | xargs -n 1 git branch -d\""

    # -------------------------------------------------------------------------
    # git submodule aliases
    # -------------------------------------------------------------------------

    sub = submodule
    subs = submodule foreach
